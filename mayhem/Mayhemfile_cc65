# Mayhem target `cc65` — the C compiler, one of cc65's public command-line tools (src/Makefile PROGS),
# built sanitized (ASan+UBSan halting; exactly two benign UBSan checks relaxed, see mayhem/build.sh)
# + SanCov edge instrumentation + DWARF-3 by mayhem/build.sh at /mayhem/cc65.
# Raw (non-libFuzzer, process-per-input) target — the tool runs exactly as shipped, one fresh process
# per input, so exit()-on-error paths and runaway expansions become normal per-exec findings.
# `cc65 -Osir -o out.s <source>`: the fuzz file is the C source; -Osir turns on the optimizer, register
# variables and stdfunc inlining (the copt*.c passes) so the whole back end is exercised, not just the
# front end. /mayhem/include is compiled in as the system include dir, so `#include <stdio.h>` resolves.
# Input delivery is a bare `@@` (no filepath:, no cwd:) — the tool does not dispatch on the file
# extension — and every output goes to a RELATIVE path in Mayhem's writable default cwd.
project: savantenvs/cc65
target: cc65

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/cc65/testsuite

cmds:
  - cmd: /mayhem/cc65 -Osir -o out.s @@
    timeout: 5
